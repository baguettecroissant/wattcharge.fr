---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | WattCharge.fr</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | WattCharge.fr`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body>
    <!-- Navbar -->
    <header class="navbar-wrapper">
      <div class="container navbar-container">
        <a href="/" class="brand-logo">
          <i class="fa-solid fa-bolt-lightning text-gradient-electric logo-icon"></i>
          <span>Watt<span class="text-gradient-electric">Charge</span></span>
        </a>
        <nav class="nav-links">
          <a href="/boutique" class="nav-link">Boutique</a>
          <a href="/a-propos" class="nav-link">À Propos</a>
          <a href="/outils" class="nav-link">Simulateurs</a>
          <a href="/blog" class="nav-link">Blog</a>
        </nav>
        <div class="nav-actions">
          <a href="/panier" class="cart-link-nav">
            <i class="fa-solid fa-cart-shopping"></i> Panier (<span id="cart-count">0</span>)
          </a>
        </div>
        <!-- Hamburger Button -->
        <button id="mobile-menu-btn" class="mobile-menu-toggle-btn" aria-label="Menu Mobile">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav-drawer" class="mobile-drawer-wrapper">
      <div class="mobile-drawer-backdrop" id="mobile-drawer-close-bg"></div>
      <div class="mobile-drawer-content">
        <div class="drawer-header">
          <a href="/" class="brand-logo">
            <i class="fa-solid fa-bolt-lightning text-gradient-electric logo-icon"></i>
            <span>Watt<span class="text-gradient-electric">Charge</span></span>
          </a>
          <button id="mobile-drawer-close-btn" class="mobile-drawer-close" aria-label="Fermer le menu">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        <nav class="drawer-links">
          <a href="/boutique" class="drawer-link"><i class="fa-solid fa-store"></i> Boutique</a>
          <a href="/a-propos" class="drawer-link"><i class="fa-solid fa-users"></i> À Propos</a>
          <a href="/outils" class="drawer-link"><i class="fa-solid fa-gauge-high"></i> Simulateurs</a>
          <a href="/blog" class="drawer-link"><i class="fa-solid fa-newspaper"></i> Blog</a>
          <a href="/faq" class="drawer-link"><i class="fa-solid fa-circle-question"></i> FAQ / Notices</a>
          <a href="/panier" class="drawer-link drawer-cart-btn"><i class="fa-solid fa-cart-shopping"></i> Mon Panier</a>
        </nav>
      </div>
    </div>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer-wrapper-premium">
      <div class="container footer-content-premium">
        <!-- Col 1 : Brand & Service client -->
        <div class="footer-col-brand">
          <a href="/" class="brand-logo-footer">
            <span>WATT<span class="text-teal">CHARGE</span></span>
          </a>
          <div class="footer-cs-box">
            <div class="cs-icon-bubble">
              <i class="fa-solid fa-comments"></i>
            </div>
            <p>Notre service client <strong>WattCharge</strong> est à votre service.</p>
          </div>
        </div>
        
        <!-- Col 2 : Liens utiles -->
        <div class="footer-col-links">
          <h4>LIENS UTILES</h4>
          <a href="/mentions-legales">Mentions légales & Confidentialité</a>
          <a href="/cgv">Conditions Générales de Vente (CGV)</a>
          <a href="/faq">FAQ & Notices de montage</a>
          <a href="/outils">Simulateurs & Calculettes EV</a>
        </div>

        <!-- Col 3 : Nos produits -->
        <div class="footer-col-links">
          <h4>NOS PRODUITS</h4>
          <a href="/produits/wattcharge-home-7">Borne de recharge 7,4 kW</a>
          <a href="/produits/wattcharge-home-11">Borne de recharge 11 kW</a>
          <a href="/produits/wattcharge-pro-22">Borne de recharge 22 kW</a>
          <a href="/boutique">Boutique Catalogue Complet</a>
        </div>

        <!-- Col 4 : Contact -->
        <div class="footer-col-contact">
          <h4>CONTACT</h4>
          <div class="contact-item">
            <i class="fa-solid fa-location-dot"></i>
            <span>115 rue de la Performance,<br />83390 Cuers</span>
          </div>
          <div class="contact-item">
            <i class="fa-solid fa-phone"></i>
            <a href="tel:0695012614">06 95 01 26 14</a>
          </div>
          <div class="contact-item">
            <i class="fa-solid fa-envelope"></i>
            <a href="mailto:support@wattcharge.fr">support@wattcharge.fr</a>
          </div>
        </div>
      </div>

      <!-- Copyright Bottom -->
      <div class="footer-bottom-premium">
        <div class="container footer-bottom-inner">
          <p class="credit-text">Réalisé avec ⚡ par Getup Agency</p>
          <div class="payment-badges-footer">
            <i class="fa-brands fa-cc-visa" title="Visa"></i>
            <i class="fa-brands fa-cc-mastercard" title="Mastercard"></i>
            <i class="fa-brands fa-cc-apple-pay" title="Apple Pay"></i>
            <i class="fa-brands fa-cc-paypal" title="PayPal"></i>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      function updateNavCartCount() {
        try {
          const cart = JSON.parse(localStorage.getItem('wattcharge_cart') || '[]');
          const count = cart.reduce((sum, item) => sum + item.quantity, 0);
          const countEl = document.getElementById('cart-count');
          if (countEl) {
            countEl.textContent = count;
          }
        } catch (e) {
          console.error('Error reading cart', e);
        }
      }
      document.addEventListener('DOMContentLoaded', updateNavCartCount);
      window.addEventListener('storage', updateNavCartCount);
      window.updateNavCartCount = updateNavCartCount;

      // Mobile Drawer Toggle
      document.addEventListener('DOMContentLoaded', () => {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('mobile-drawer-close-btn');
        const closeBg = document.getElementById('mobile-drawer-close-bg');
        const drawer = document.getElementById('mobile-nav-drawer');

        if (mobileBtn && drawer) {
          mobileBtn.addEventListener('click', () => {
            drawer.classList.add('open');
            document.body.style.overflow = 'hidden';
          });
        }

        const closeDrawer = () => {
          if (drawer) {
            drawer.classList.remove('open');
            document.body.style.overflow = '';
          }
        };

        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (closeBg) closeBg.addEventListener('click', closeDrawer);
      });
    </script>
  </body>
</html>

<style>
  /* Header styling - Glassmorphic Fixed Navbar */
  .navbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
    transition: all 0.3s ease;
  }

  .navbar-container {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--text-primary);
  }

  .logo-icon {
    font-size: 1.8rem;
    filter: drop-shadow(0 2px 5px rgba(83, 183, 168, 0.3));
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    transition: var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--accent-teal);
  }

  .btn-primary-sm {
    padding: 10px 20px;
    font-size: 0.9rem;
    border-radius: 8px;
  }

  /* Premium Rounded Footer - Inspired by Competitor BornePlus */
  .footer-wrapper-premium {
    background: #e6f4f2; /* Light premium mint background */
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    padding-top: 80px;
    margin-top: 0;
    position: relative;
    z-index: 10;
    box-shadow: 0 -10px 40px rgba(83, 183, 168, 0.05);
    border-top: 1px solid rgba(83, 183, 168, 0.15);
  }

  .footer-content-premium {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }

  @media (max-width: 992px) {
    .footer-content-premium {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 576px) {
    .footer-content-premium {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  /* Col 1 Brand & Customer Service */
  .footer-col-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .brand-logo-footer {
    font-size: 1.6rem;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-decoration: none;
    color: #0f172a;
    font-family: var(--font-heading);
  }

  .brand-logo-footer .text-teal {
    color: var(--accent-teal);
  }

  .footer-cs-box {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(83, 183, 168, 0.2);
    border-radius: 16px;
    padding: 16px;
    max-width: 280px;
  }

  .cs-icon-bubble {
    width: 44px;
    height: 44px;
    border-radius: 50px;
    background: var(--accent-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.2rem;
    flex-shrink: 0;
    animation: pulseBubble 3s infinite;
  }

  @keyframes pulseBubble {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(83, 183, 168, 0.4); }
    70% { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(83, 183, 168, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(83, 183, 168, 0); }
  }

  .footer-cs-box p {
    font-size: 0.85rem;
    color: #334155;
    line-height: 1.4;
    margin: 0;
  }

  /* Col Links & Contact */
  .footer-col-links, .footer-col-contact {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-col-links h4, .footer-col-contact h4 {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
  }

  .footer-col-links a {
    color: #475569;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: var(--transition-fast);
  }

  .footer-col-links a:hover {
    color: var(--accent-teal);
    transform: translateX(3px);
  }

  .footer-col-contact {
    color: #475569;
    font-size: 0.95rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }

  .contact-item i {
    color: var(--accent-teal);
    font-size: 1.1rem;
    margin-top: 3px;
    width: 16px;
    text-align: center;
  }

  .contact-item a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }

  .contact-item a:hover {
    color: var(--accent-teal);
  }

  /* Bottom Copyright panel */
  .footer-bottom-premium {
    border-top: 1px solid rgba(83, 183, 168, 0.12);
    padding: 25px 0;
    background: rgba(255, 255, 255, 0.3);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 576px) {
    .footer-bottom-inner {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }

  .credit-text {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
    margin: 0;
  }

  .payment-badges-footer {
    display: flex;
    gap: 15px;
    font-size: 1.6rem;
    color: #64748b;
  }

  .payment-badges-footer i:hover {
    color: var(--accent-teal);
  }

  .cart-link-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--gradient-electric);
    color: #ffffff;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.9rem;
    box-shadow: var(--shadow-glow);
    transition: var(--transition-fast);
  }

  .cart-link-nav:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }

  /* Hamburger Button */
  .mobile-menu-toggle-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 8px;
    transition: var(--transition-fast);
  }

  .mobile-menu-toggle-btn:hover {
    color: var(--accent-teal);
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none !important;
    }
    
    .nav-actions {
      margin-left: auto;
      margin-right: 10px;
    }

    .mobile-menu-toggle-btn {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .cart-link-nav span {
      display: none; /* Hide text on small screens, keep icon */
    }
  }

  /* Drawer Wrapper */
  .mobile-drawer-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer-wrapper.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.4);
    backdrop-filter: blur(8px);
  }

  .mobile-drawer-content {
    position: absolute;
    top: 0;
    right: -320px;
    width: 320px;
    height: 100%;
    background: #ffffff;
    box-shadow: -10px 0 40px rgba(15, 23, 42, 0.15);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer-wrapper.open .mobile-drawer-content {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 20px;
  }

  .mobile-drawer-close {
    background: none;
    border: none;
    font-size: 1.6rem;
    color: var(--text-primary);
    cursor: pointer;
    transition: var(--transition-fast);
  }

  .mobile-drawer-close:hover {
    color: var(--accent-teal);
  }

  .drawer-links {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer-link {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 12px 16px;
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .drawer-link i {
    color: var(--accent-teal);
    width: 20px;
    text-align: center;
  }

  .drawer-link:hover {
    background: var(--bg-secondary);
    color: var(--accent-teal);
    padding-left: 20px;
  }

  .drawer-cart-btn {
    margin-top: 20px;
    background: var(--gradient-electric);
    color: #ffffff !important;
    justify-content: center;
    box-shadow: var(--shadow-glow);
  }

  .drawer-cart-btn i {
    color: #ffffff;
  }

  .drawer-cart-btn:hover {
    background: var(--gradient-electric);
    opacity: 0.95;
    padding-left: 16px;
  }
</style>
