---
import Layout from '../../layouts/Layout.astro';
import { stripe } from '../../lib/stripe';
import { processSuccessfulOrder } from '../../lib/orders';

export const prerender = false;

let orderId = Astro.url.searchParams.get('order_id') || '';
const sessionId = Astro.url.searchParams.get('session_id') || '';
let formulaId = Astro.url.searchParams.get('formula_id') || '';

let orderDetails: any = null;
let errorMsg = '';

// 1. Redirection Stripe Success
if (sessionId) {
  try {
    const session = await stripe.checkout.sessions.retrieve(sessionId);
    if (session.payment_status === 'paid') {
      const email = session.customer_details?.email || '';
      const name = session.customer_details?.name || 'Client Stripe';
      const address = {
        line1: session.shipping_details?.address?.line1 || '',
        line2: session.shipping_details?.address?.line2 || '',
        city: session.shipping_details?.address?.city || '',
        postal_code: session.shipping_details?.address?.postal_code || '',
        country: session.shipping_details?.address?.country || '',
      };
      
      const prodId = session.metadata?.productId || formulaId || 'wattcharge-home-7';
      const totalAmount = (session.amount_total || 0) / 100;

      // Traiter la commande (Emails + Sourcing)
      const result = await processSuccessfulOrder({
        email,
        name,
        shippingAddress: address,
        productId: prodId,
        totalAmount,
        paymentId: sessionId,
        gateway: 'stripe'
      });
      
      orderId = result.orderId;
      
      orderDetails = {
        id: orderId,
        customer_name: name,
        customer_email: email,
        total_amount: totalAmount,
        shipping_address: address
      };
    } else {
      errorMsg = "Le paiement Stripe n'a pas été validé.";
    }
  } catch (e: any) {
    console.error("Erreur traitement Stripe Success:", e);
    errorMsg = `Erreur lors de la validation Stripe : ${e.message}`;
  }
}

// 2. Fallback pour PayPal ou démo locale si pas de Stripe session
if (orderId && !orderDetails) {
  orderDetails = {
    id: orderId,
    customer_name: 'Client WattCharge',
    customer_email: 'client@wattcharge.fr',
    total_amount: formulaId.includes('22') ? 489.00 : formulaId.includes('11') ? 449.00 : 389.00,
    shipping_address: {
      line1: '123 Rue de la Recharge',
      city: 'Paris',
      postal_code: '75001',
      country: 'FR'
    }
  };
}

if (!orderId && !errorMsg) {
  errorMsg = "Identifiant de commande manquant. Veuillez contacter le support.";
}
---

<Layout 
  title="Commande Confirmée" 
  description="Merci pour votre achat sur WattCharge.fr. Retrouvez ici le statut de votre commande."
>
  <section class="success-section">
    <div class="success-glow"></div>
    <div class="container success-container">
      
      {errorMsg ? (
        <div class="error-card glass-panel">
          <div class="error-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
          <h2>Un problème est survenu</h2>
          <p>{errorMsg}</p>
          <a href="/" class="btn-primary">Retour à l'accueil</a>
        </div>
      ) : (
        <div class="success-card glass-panel">
          <div class="success-header-badge">
            <i class="fa-solid fa-circle-check text-gradient-electric"></i>
            <span>Paiement Réussi</span>
          </div>
          
          <h1 class="success-title">Merci pour Votre Commande !</h1>
          <p class="success-intro">
            Votre commande <strong>#{orderDetails.id.substring(0, 8)}</strong> a été validée. Un e-mail de confirmation contenant votre facture a été envoyé à <strong>{orderDetails.customer_email}</strong>.
          </p>
          
          <!-- Stepper de livraison -->
          <div class="stepper-container">
            <h3 class="stepper-title">Suivi de votre livraison</h3>
            <div class="stepper">
              <div class="step step-active">
                <div class="step-num"><i class="fa-solid fa-check"></i></div>
                <span>Payée</span>
              </div>
              <div class="step step-active">
                <div class="step-num"><i class="fa-solid fa-box-open"></i></div>
                <span>Préparation</span>
              </div>
              <div class="step step-pending">
                <div class="step-num"><i class="fa-solid fa-truck"></i></div>
                <span>Expédiée</span>
              </div>
              <div class="step step-pending">
                <div class="step-num"><i class="fa-solid fa-house-chimney"></i></div>
                <span>Livrée</span>
              </div>
            </div>
          </div>

          <!-- Détails de livraison -->
          <div class="delivery-details">
            <h3><i class="fa-solid fa-truck-fast"></i> Informations de livraison</h3>
            <p>
              <strong>Destinataire :</strong> {orderDetails.customer_name}<br />
              <strong>Adresse :</strong> {orderDetails.shipping_address?.line1 || orderDetails.shipping_address?.street || ''}, {orderDetails.shipping_address?.postal_code || orderDetails.shipping_address?.postalCode || ''} {orderDetails.shipping_address?.city || ''}, {orderDetails.shipping_address?.country || ''}
            </p>
            <div class="shipping-notice">
              <i class="fa-solid fa-circle-info"></i>
              <span>Expédié depuis notre entrepôt européen sous 24/48h. Un e-mail contenant le numéro de suivi DHL / GLS vous sera envoyé dès l'expédition.</span>
            </div>
          </div>

          <div class="actions">
            <a href="/" class="btn-primary">Retourner à l'accueil</a>
          </div>
        </div>
      )}

    </div>
  </section>
</Layout>

<style>
  .success-section {
    padding-top: 160px;
    padding-bottom: 80px;
    position: relative;
    background: var(--gradient-dark);
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
  }

  .success-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(83, 183, 168, 0.08) 0%, rgba(111, 148, 166, 0.03) 50%, transparent 100%);
    filter: blur(80px);
    pointer-events: none;
  }

  .success-container {
    position: relative;
    z-index: 2;
  }

  .success-card {
    max-width: 650px;
    margin: 0 auto;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-shadow: var(--shadow-card);
    background: #ffffff;
  }

  .success-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(83, 183, 168, 0.05);
    border: 1px solid rgba(83, 183, 168, 0.2);
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-teal);
    width: fit-content;
  }

  .success-header-badge i {
    font-size: 1rem;
    filter: drop-shadow(0 2px 4px rgba(83, 183, 168, 0.3));
  }

  .success-title {
    font-size: 2.2rem;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .success-intro {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .success-intro strong {
    color: var(--text-primary);
  }

  /* Stepper */
  .stepper-container {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 24px;
    border-radius: 12px;
  }

  .stepper-title {
    font-size: 1.1rem;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  .stepper {
    display: flex;
    justify-content: space-between;
    position: relative;
  }

  .stepper::before {
    content: '';
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    height: 2px;
    background: var(--border-color);
    z-index: 1;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    position: relative;
    z-index: 2;
    width: 25%;
  }

  .step-num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    transition: var(--transition-smooth);
    color: var(--text-muted);
  }

  .step span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .step-active .step-num {
    background: var(--gradient-electric);
    border-color: var(--accent-teal);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
  }

  .step-active span {
    color: var(--accent-teal);
    font-weight: 700;
  }

  /* Delivery Details */
  .delivery-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .delivery-details h3 {
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
  }

  .delivery-details p {
    color: var(--text-secondary);
    line-height: 1.6;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 16px;
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .shipping-notice {
    display: flex;
    gap: 10px;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .shipping-notice i {
    color: var(--accent-teal);
    font-size: 1rem;
    margin-top: 2px;
  }

  .actions {
    display: flex;
    justify-content: center;
    margin-top: 10px;
  }

  .actions .btn-primary {
    width: 100%;
    justify-content: center;
  }

  /* Error Card */
  .error-card {
    max-width: 500px;
    margin: 40px auto;
    padding: 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: var(--shadow-card);
    background: #ffffff;
  }

  .error-icon {
    font-size: 3rem;
    color: #ef4444;
  }
</style>
