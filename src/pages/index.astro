---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const DEFAULT_PRODUCTS = [
  {
    id: 'wattcharge-home-7',
    name: 'WattCharge Home 7.4',
    description: 'Borne de recharge connectée 7.4kW monophasée idéale pour les habitations standard. Intègre le pilotage WiFi Tuya et la protection différentielle type B obligatoire.',
    price: 389.00,
    compare_at_price: 599.00,
    power_output: '7.4 kW',
    phase: 'Monophasé',
    current_rating: '32A',
    features: ['Puissance réglable jusqu\'à 7.4kW', 'Monophasé 230V', 'Tuya Smart App WiFi', 'Protection RCD DC 6mA intégrée']
  },
  {
    id: 'wattcharge-home-11',
    name: 'WattCharge Home 11',
    description: 'Borne de recharge triphasée 11kW conçue pour une charge accélérée sécurisée. Parfaite pour les maisons équipées en triphasé.',
    price: 449.00,
    compare_at_price: 699.00,
    power_output: '11 kW',
    phase: 'Triphasé',
    current_rating: '16A',
    features: ['Puissance réglable jusqu\'à 11kW', 'Triphasé 400V', 'Tuya Smart App WiFi', 'Protection RCD DC 6mA intégrée']
  },
  {
    id: 'wattcharge-pro-22',
    name: 'WattCharge Pro 22',
    description: 'Le modèle le plus performant pour une charge triphasée ultra-rapide à 22kW. Livré complet avec câble type 2 de 5 mètres.',
    price: 489.00,
    compare_at_price: 799.00,
    power_output: '22 kW',
    phase: 'Triphasé',
    current_rating: '32A',
    features: ['Puissance réglable jusqu\'à 22kW', 'Triphasé 400V', 'Tuya Smart App WiFi', 'Protection RCD DC 6mA intégrée']
  }
];

const products = DEFAULT_PRODUCTS;
---

<Layout 
  title="WattCharge.fr | Bornes de Recharge EV Connectées Premium" 
  description="Découvrez nos bornes de recharge de 7.4kW à 22kW, conformes à la norme française RCD DC 6mA. Option d'installation IRVE."
>
  <!-- Section HERO -->
  <section class="hero-section">
    <div class="hero-bg-glow"></div>
    <div class="container hero-container">
      <div class="hero-text-content">
        <div class="hero-badge">
          <span class="pulse-indicator"></span>
          <span>Sourcing Entrepôts Europe (Livraison 3-5 jours)</span>
        </div>
        <h1 class="hero-title">
          Votre Borne Connectée <br />
          <span class="text-gradient-electric">Au Meilleur Prix</span>
        </h1>
        <p class="hero-subtitle">
          Sélectionnez nos bornes de recharge haut de gamme de <strong>7.4 kW (monophasé)</strong> à <strong>22 kW (triphasé)</strong>. Équipées du WiFi, de badges RFID et de la protection différentielle obligatoire <strong>RCD DC 6mA</strong>.
        </p>
        
        <div class="hero-cta-group">
          <a href="#catalog" class="btn-primary">
            Voir le Catalogue <i class="fa-solid fa-cart-shopping"></i>
          </a>
        </div>

        <div class="hero-trust">
          <div class="stars">
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
            <i class="fa-solid fa-star"></i>
          </div>
          <span class="trust-text"><strong>4.9 / 5</strong> basé sur +140 avis installateurs français</span>
        </div>
      </div>

      <!-- Spacer pour décaler le texte de l'image de fond du garage futuriste sur grand écran -->
      <div class="hero-spacer"></div>
    </div>
  </section>

  <!-- Grille de Produits (Catalog) -->
  <section class="catalog-section" id="catalog">
    <div class="container">
      <div class="section-header">
        <span class="badge-certified">Notre Gamme</span>
        <h2>Bornes de Recharge WattCharge</h2>
        <p>Découvrez nos 3 modèles conçus pour recharger rapidement et en toute sécurité votre véhicule électrique à domicile.</p>
      </div>

      <div class="products-grid">
        {products.map((product) => {
          const isPro = product.id.includes('22');
          return (
            <div class={`product-card glass-panel ${isPro ? 'featured-card' : ''}`}>
              {isPro && <div class="card-badge">Le plus puissant</div>}
              <div class="product-card-image">
                <img src="/images/charger.png" alt={product.name} />
              </div>
              <div class="product-card-body">
                <h3 class="product-name">{product.name}</h3>
                <div class="product-specs-badges">
                  <span class="spec-badge"><i class="fa-solid fa-bolt"></i> {product.power_output}</span>
                  <span class="spec-badge"><i class="fa-solid fa-wave-square"></i> {product.phase}</span>
                  <span class="spec-badge"><i class="fa-solid fa-gauge-simple"></i> {product.current_rating}</span>
                </div>
                <p class="product-desc">{product.description}</p>
                
                <div class="product-features-list">
                  {product.features?.slice(0, 3).map((feat) => (
                    <span class="feat-bullet"><i class="fa-solid fa-circle-check text-gradient-electric"></i> {feat}</span>
                  ))}
                </div>

                <div class="product-card-footer">
                  <div class="price-block">
                    <span class="current-price">{Number(product.price).toFixed(2).replace('.', ',')} €</span>
                    {product.compare_at_price && (
                      <span class="compare-price">{Number(product.compare_at_price).toFixed(2).replace('.', ',')} €</span>
                    )}
                  </div>
                  <a href={`/produits/${product.id}`} class="btn-primary card-cta-btn">
                    Configurer <i class="fa-solid fa-chevron-right"></i>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>



  <!-- Reassurance Grid -->
  <section class="reassurance-bar">
    <div class="container reassurance-container">
      <div class="reassurance-item">
        <i class="fa-solid fa-truck-fast"></i>
        <div>
          <h4>Livraison Rapide</h4>
          <p>Expédition sous 24/48h depuis l'Europe.</p>
        </div>
      </div>
      <div class="reassurance-item">
        <i class="fa-solid fa-shield-halved"></i>
        <div>
          <h4>Conforme aux Normes</h4>
          <p>Toutes nos bornes disposent du marquage CE et RCD DC 6mA.</p>
        </div>
      </div>
      <div class="reassurance-item">
        <i class="fa-solid fa-user-shield"></i>
        <div>
          <h4>Paiement 100% Sécurisé</h4>
          <p>Stripe (CB/Apple Pay) et PayPal (Option 4x sans frais).</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Section layouts */
  section {
    padding: 90px 0;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px auto;
  }

  .section-header h2 {
    font-size: 2.6rem;
    margin-top: 12px;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  /* Hero Section - Clean Light with Futuristic BG */
  .hero-section {
    position: relative;
    padding-top: 200px;
    padding-bottom: 150px;
    overflow: hidden;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.95) 45%, rgba(255, 255, 255, 0.25) 100%), url('/images/hero_bg.png') no-repeat center right;
    background-size: cover;
  }

  .hero-bg-glow {
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(83, 183, 168, 0.1) 0%, rgba(111, 148, 166, 0.02) 50%, transparent 100%);
    filter: blur(80px);
    z-index: 1;
    pointer-events: none;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 992px) {
    .hero-section {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 60%, rgba(255, 255, 255, 0.95) 100%), url('/images/hero_bg.png') no-repeat center center;
      background-size: cover;
      padding-top: 150px;
      padding-bottom: 80px;
    }
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }
    .hero-spacer {
      display: none;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 24px;
    box-shadow: var(--shadow-card);
  }

  .hero-title {
    font-size: 3.8rem;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  @media (max-width: 576px) {
    .hero-title {
      font-size: 2.6rem;
    }
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
    max-width: 580px;
  }

  .hero-cta-group {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
  }

  @media (max-width: 992px) {
    .hero-cta-group {
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .hero-cta-group {
      flex-direction: column;
      gap: 12px;
    }
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  @media (max-width: 992px) {
    .hero-trust {
      justify-content: center;
    }
  }

  .stars {
    color: #f59e0b;
    display: flex;
    gap: 2px;
  }

  .trust-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .hero-image-card {
    padding: 30px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: var(--shadow-card);
    position: relative;
    background: #ffffff;
  }

  .hero-image-card::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(83, 183, 168, 0.15) 0%, transparent 70%);
    filter: blur(30px);
    z-index: -1;
    pointer-events: none;
  }

  .hero-image {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* Catalog Products Grid */
  .catalog-section {
    background: var(--bg-secondary);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  @media (max-width: 992px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  .featured-card {
    border-color: rgba(83, 183, 168, 0.4);
    box-shadow: 0 10px 30px rgba(83, 183, 168, 0.06), var(--shadow-card);
  }

  .card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--gradient-electric);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 100px;
    text-transform: uppercase;
  }

  .product-card-image {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .product-card-image img {
    max-width: 100%;
    height: 180px;
    object-fit: contain;
    transition: var(--transition-smooth);
  }

  .product-card:hover .product-card-image img {
    transform: scale(1.05);
  }

  .product-name {
    font-size: 1.4rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .product-specs-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .spec-badge {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .product-desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .product-features-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
  }

  .feat-bullet {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .price-block {
    display: flex;
    flex-direction: column;
  }

  .current-price {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent-teal);
    font-family: var(--font-heading);
  }

  .compare-price {
    font-size: 0.9rem;
    text-decoration: line-through;
    color: var(--text-muted);
  }

  .card-cta-btn {
    padding: 10px 16px;
    font-size: 0.85rem;
    border-radius: 8px;
  }

  /* Installation Service Details Section */
  .installation-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  @media (max-width: 992px) {
    .installation-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .lead-text {
    font-size: 1.2rem;
    color: var(--text-primary);
    line-height: 1.6;
    margin-top: 16px;
    margin-bottom: 16px;
    font-weight: 600;
  }

  .installation-text-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .installation-benefits {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 30px;
  }

  .benefit-item {
    display: flex;
    gap: 16px;
  }

  .benefit-item i {
    font-size: 1.4rem;
    color: var(--accent-teal);
    background: rgba(83, 183, 168, 0.08);
    width: 44px;
    height: 44px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(83, 183, 168, 0.15);
    flex-shrink: 0;
  }

  .benefit-item h4 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .benefit-item p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .installation-visual .visual-card {
    padding: 40px;
    box-shadow: var(--shadow-card);
    background: #ffffff;
  }

  .installation-visual h3 {
    margin-bottom: 24px;
    font-size: 1.4rem;
  }

  .step-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .step-list-item {
    display: flex;
    gap: 16px;
  }

  .step-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--gradient-electric);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-family: var(--font-heading);
    flex-shrink: 0;
  }

  .step-list-item h4 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }

  .step-list-item p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  /* Reassurance Bar */
  .reassurance-bar {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 30px 0;
  }

  .reassurance-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  @media (max-width: 768px) {
    .reassurance-container {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .reassurance-item {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .reassurance-item i {
    font-size: 2rem;
    color: var(--accent-teal);
    background: rgba(83, 183, 168, 0.08);
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(83, 183, 168, 0.15);
    flex-shrink: 0;
  }

  .reassurance-item h4 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .reassurance-item p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
</style>
