];

const product = DEFAULT_PRODUCTS.find(p => p.id === id);

if (!product) {
  return Astro.redirect('/');
}

const paypalClientId = import.meta.env.PAYPAL_CLIENT_ID || 'placeholder-client-id';
---

<Layout 
  title={`${product.name}`} 
  description={product.description.substring(0, 160)}
>
  <section class="product-detail-section">
    <div class="product-glow"></div>
    <div class="container">
      
      <div class="product-detail-grid">
        <!-- Colonne Gauche : Galerie Image -->
        <div class="product-gallery-column">
          <a href="/#catalog" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour au catalogue</a>
          
          <div class="main-image-card glass-panel">
            <img src="/images/charger.png" alt={product.name} class="detail-product-img" />
            <div class="power-overlay">{product.power_output}</div>
          </div>
          
          <div class="product-guarantees-grid">
            <div class="guarantee-badge-item glass-panel">
              <i class="fa-solid fa-shield-check text-gradient-electric"></i>
              <div>
                <strong>Garantie 2 Ans</strong>
                <p>Échange standard gratuit.</p>
              </div>
            </div>
            <div class="guarantee-badge-item glass-panel">
              <i class="fa-solid fa-truck-fast text-gradient-electric"></i>
              <div>
                <strong>Livraison Offerte</strong>
                <p>Expédition sous 24/48h.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Colonne Droite : Configuration & Achat -->
        <div class="product-info-column">
          <div class="product-header">
            <span class="badge-certified"><i class="fa-solid fa-circle-check"></i> Produit Certifié CE</span>
            <h1 class="product-title">{product.name}</h1>
            <p class="product-subtitle">{product.subtitle}</p>
            
            <div class="product-rating">
              <div class="stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <span>(43 avis clients)</span>
              <span class="stock-indicator"><span class="pulse-indicator"></span> En Stock (3-5 jours)</span>
            </div>

            <div class="price-header-block">
              <span class="detail-price">{Number(product.price).toFixed(2).replace('.', ',')} €</span>
              {product.compare_at_price && (
                <span class="detail-compare-price">{Number(product.compare_at_price).toFixed(2).replace('.', ',')} €</span>
              )}
            </div>
          </div>

          <p class="detail-desc">{product.description}</p>

          <!-- Avantages Clés -->
          <div class="key-features-bullets">
            <h4><i class="fa-solid fa-circle-info"></i> Points clés :</h4>
            <ul>
              {product.features.map(f => (
                <li><i class="fa-solid fa-check text-gradient-electric"></i> {f}</li>
              ))}
            </ul>
          </div>

          <!-- Module d'Achat direct -->
          <div class="checkout-actions-block">
            <button id="stripe-buy-btn" class="btn-primary select-formula-btn">
              Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>
            </button>
            <div class="checkout-divider">
              <span>OU</span>
            </div>
            <!-- PayPal Button Container -->
            <div id="paypal-button-container"></div>
          </div>

          <div class="secure-badge-row">
            <span><i class="fa-solid fa-lock"></i> Transaction Sécurisée SSL</span>
            <span><i class="fa-solid fa-rotate-left"></i> Satisfait ou Remboursé 14j</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1 : CARACTÉRISTIQUES TECHNIQUES DE LA BORNE DE RECHARGE (Design BornePlus) -->
  <section class="section-tech-specs">
    <div class="container">
      <h2 class="section-title-specs">CARACTÉRISTIQUES TECHNIQUES DE LA BORNE DE RECHARGE</h2>
      
      <div class="specs-icons-grid">
        <div class="spec-icon-card">
          <i class="fa-solid fa-bolt"></i>
          <h4>Max puissance de charge : {product.specs_grid.power}</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-tv"></i>
          <h4>Écran LED Couleur</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-circle-nodes"></i>
          <h4>Courant de sortie : {product.specs_grid.current}</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-arrows-left-right"></i>
          <h4>Longueur du câble de terre : {product.specs_grid.ground_cable}</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-plug"></i>
          <h4>Prise : Type 2</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-circle-notch"></i>
          <h4>Statut par grand cercle LED coloré</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-shield-halved"></i>
          <h4>Antivol électronique du véhicule</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-power-off"></i>
          <h4>Bouton d'arrêt d'urgence latéral</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-wifi"></i>
          <h4>Possibilité de connexion WIFI : Oui</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-toolbox"></i>
          <h4>Support mural métallique inclus</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-box"></i>
          <h4>Matériau du boîtier : Polycarbonate</h4>
        </div>
        <div class="spec-icon-card">
          <i class="fa-solid fa-shield-check"></i>
          <h4>{product.specs_grid.rcd}</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 : FONCTIONNALITÉS (Design BornePlus) -->
  <section class="section-features">
    <div class="container features-flex">
      <div class="features-visual">
        <div class="visual-box-mockup">
          <img src="/images/charger.png" alt="WattCharge Smart Wallbox" />
        </div>
      </div>
      <div class="features-content">
        <h2>FONCTIONNALITÉS</h2>
        <ul class="features-checked-list">
          <li><i class="fa-solid fa-check"></i> Démarrage de la recharge par carte de recharge IC</li>
          <li><i class="fa-solid fa-check"></i> Démarrage à distance par application mobile</li>
          <li><i class="fa-solid fa-check"></i> Contrôle de charge à distance</li>
          <li><i class="fa-solid fa-check"></i> Arrêt de la recharge à distance ou par bouton</li>
          <li><i class="fa-solid fa-check"></i> Vérification à distance de la charge de réserve</li>
          <li><i class="fa-solid fa-check"></i> Notifications en temps réel</li>
          <li><i class="fa-solid fa-check"></i> Contrôle intelligent de la température</li>
          <li><i class="fa-solid fa-check"></i> Contrôle précis de la tension</li>
          <li><i class="fa-solid fa-check"></i> Historique complet des recharges</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SECTION 3 : SÉCURITÉ (Design BornePlus) -->
  <section class="section-security">
    <div class="container security-grid">
      <div class="security-left">
        <h2>SÉCURITÉ</h2>
        <p class="security-subtitle-text">Protection garantie contre les risques</p>
        
        <div class="security-cards-box">
          {product.protections.map(p => (
            <div class="security-detail-card">
              <i class="fa-solid fa-shield-halved"></i>
              <div>
                <h4>{p.name}</h4>
                <p>{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="security-right">
        <div class="security-visual-image-wrapper">
          <img src="/images/electrician_installation.png" alt="Professionnel de la sécurité électrique" />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 : VOTRE INDÉPENDANCE, À PORTÉE DE MAIN (Design BornePlus) -->
  <section class="section-independence">
    <div class="container">
      <div class="independence-header">
        <h2>VOTRE INDÉPENDANCE, À PORTÉE DE MAIN</h2>
        <p>La solution qui vous rend autonome</p>
      </div>
      
      <div class="independence-cards">
        <div class="independence-card">
          <h3>Ne dépendez pas des bornes publiques</h3>
          <p>
            Malgré le programme de déploiement de 100 000 bornes sur le territoire français, le droit à la prise est loin d'être effectif, sachant que les structures de recharge publiques sont rarement libres en journée. Les conducteurs et propriétaires de voiture électrique doivent faire la queue ou partir à la recherche d'une autre borne en poursuivant leur chargemap, ce qui est très coûteux en temps et en argent.
          </p>
          <a href="/#catalog" class="btn-learn-more"><i class="fa-solid fa-plus"></i> EN SAVOIR PLUS</a>
        </div>
        <div class="independence-card">
          <h3>Une borne de recharge rapide, qui attend dans votre garage</h3>
          <p>
            La station de recharge WattCharge a été pensée pour tous les profils d'utilisateurs de véhicule électrique. Composée d'un boîtier de recharge robuste, étanche et léger, elle se fixe simplement au mur d'un garage ou dans un endroit couvert de votre cour extérieure pour être toujours prête.
          </p>
          <a href="/#catalog" class="btn-learn-more"><i class="fa-solid fa-plus"></i> EN SAVOIR PLUS</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5 : SIMULATEUR DE CHARGE -->
  <section class="section-simulator">
    <div class="container">
      <div class="product-simulator-wrapper glass-panel">
        <div class="simulator-header">
          <h3>Simulateur de Temps de Recharge</h3>
          <p>Configurez le niveau de batterie souhaité pour mesurer la vitesse de charge par rapport à une prise classique.</p>
        </div>
        
        <div class="simulator-inner-grid">
          <div class="simulator-fields">
            <div class="control-group">
              <label for="slider-qualif">Niveau de charge ciblé</label>
              <div class="slider-display">
                <span id="slider-range-text">De 20% à 80%</span>
                <strong id="slider-percentage-text">+60%</strong>
              </div>
              <input type="range" id="slider-qualif" min="10" max="100" value="60" class="range-slider" />
            </div>
            
            <div class="simulator-vehicle-specs">
              <span>Puissance délivrée par cette borne : <strong>{product.power_output}</strong></span>
              <span>Réseau nécessaire : <strong>{product.phase} ({product.current_rating})</strong></span>
            </div>
          </div>

          <div class="simulator-visual-results">
            <div class="vis-result-item">
              <span>Prise Domestique Standard (2.3 kW)</span>
              <strong id="time-standard-val">--</strong>
            </div>
            <div class="vis-result-item highlight-item">
              <span class="text-gradient-electric"><i class="fa-solid fa-bolt"></i> Borne WattCharge ({product.power_output})</span>
              <strong id="time-borne-val" class="text-gradient-electric">--</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Scripts client pour l'interactivité, Stripe et PayPal -->
<script define:vars={{ productId: product.id, basePrice: product.price, powerOutput: product.power_output, paypalClientId }}>
  // DOM
  const stripeBtn = document.getElementById('stripe-buy-btn');

  // 1. Intégration Stripe Checkout
  stripeBtn.addEventListener('click', async () => {
    stripeBtn.disabled = true;
    stripeBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Redirection vers Stripe...';

    try {
      const response = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          productId: productId
        })
      });

      const data = await response.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Erreur Stripe : ' + (data.error || 'Inconnue'));
        stripeBtn.disabled = false;
        stripeBtn.innerHTML = 'Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>';
      }
    } catch (e) {
      console.error(e);
      alert('Erreur réseau. Impossible de contacter le serveur.');
      stripeBtn.disabled = false;
      stripeBtn.innerHTML = 'Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>';
    }
  });

  // 2. Intégration PayPal SDK
  function initPayPalSDK() {
    const container = document.getElementById('paypal-button-container');
    container.innerHTML = '';

    if (window.paypal) {
      renderPayPalButtons();
    } else {
      const script = document.createElement('script');
      script.src = `https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=EUR&components=buttons`;
      script.onload = renderPayPalButtons;
      document.body.appendChild(script);
    }
  }

  function renderPayPalButtons() {
    window.paypal.Buttons({
      createOrder: async function() {
        const response = await fetch('/api/create-paypal-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            productId: productId
          })
        });
        const order = await response.json();
        return order.id;
      },
      onApprove: async function(data) {
        const response = await fetch('/api/capture-paypal-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            orderID: data.orderID, 
            formulaId: productId
          })
        });
        const captureData = await response.json();
        if (captureData.status === 'COMPLETED') {
          window.location.href = `/checkout/success?order_id=${captureData.orderId}&formula_id=${productId}`;
        } else {
          alert('Le paiement PayPal n\'a pas pu être capturé.');
        }
      },
      onError: function(err) {
        console.error('PayPal Error:', err);
        alert('Erreur PayPal. Veuillez réessayer.');
      }
    }).render('#paypal-button-container');
  }

  initPayPalSDK();

  // 3. Code du mini-simulateur de charge
  const sliderQualif = document.getElementById('slider-qualif');
  const sliderRangeText = document.getElementById('slider-range-text');
  const sliderPercentageText = document.getElementById('slider-percentage-text');
  const timeStandardVal = document.getElementById('time-standard-val');
  const timeBorneVal = document.getElementById('time-borne-val');

  const maxPower = parseFloat(powerOutput);

  function updateSimulation() {
    const value = parseInt(sliderQualif.value);
    sliderRangeText.textContent = `De 20% à ${20 + value}%`;
    sliderPercentageText.textContent = `+${value}%`;

    const batteryCapacity = 52;
    const energyNeeded = batteryCapacity * (value / 100);

    const hoursStandard = energyNeeded / 2.3;
    timeStandardVal.textContent = formatHours(hoursStandard);

    const hoursBorne = energyNeeded / maxPower;
    timeBorneVal.textContent = formatHours(hoursBorne);
  }

  function formatHours(decimalHours) {
    const hours = Math.floor(decimalHours);
    const minutes = Math.round((decimalHours - hours) * 60);
    if (hours === 0) return `${minutes}m`;
    return `${hours}h ${minutes.toString().padStart(2, '0')}m`;
  }

  sliderQualif.addEventListener('input', updateSimulation);
  updateSimulation();
</script>

<style>
  .product-detail-section {
    padding-top: 150px;
    padding-bottom: 60px;
    position: relative;
    background: var(--gradient-dark);
  }

  .product-glow {
    position: absolute;
    top: -200px;
    right: 5%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(83, 183, 168, 0.08) 0%, rgba(111, 148, 166, 0.02) 50%, transparent 100%);
    filter: blur(80px);
    pointer-events: none;
  }

  .product-detail-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
