<!-- Scripts client pour l'interactivité, Stripe, PayPal et effets 3D / HUD -->
<script define:vars={{ productId: product.id, basePrice: product.price, powerOutput: product.power_output, paypalClientId }}>
  // DOM
  const stripeBtn = document.getElementById('stripe-buy-btn');

  // 1. Intégration Stripe Checkout
  stripeBtn.addEventListener('click', async () => {
    stripeBtn.disabled = true;
    stripeBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Redirection vers Stripe...';

    try {
      const response = await fetch('/api/create-checkout-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          productId: productId
        })
      });

      const data = await response.json();
      if (data.url) {
        window.location.href = data.url;
      } else {
        alert('Erreur Stripe : ' + (data.error || 'Inconnue'));
        stripeBtn.disabled = false;
        stripeBtn.innerHTML = 'Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>';
      }
    } catch (e) {
      console.error(e);
      alert('Erreur réseau. Impossible de contacter le serveur.');
      stripeBtn.disabled = false;
      stripeBtn.innerHTML = 'Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>';
    }
  });

  // 2. Intégration PayPal SDK
  function initPayPalSDK() {
    const container = document.getElementById('paypal-button-container');
    container.innerHTML = '';

    if (window.paypal) {
      renderPayPalButtons();
    } else {
      const script = document.createElement('script');
      script.src = `https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=EUR&components=buttons`;
      script.onload = renderPayPalButtons;
      document.body.appendChild(script);
    }
  }

  function renderPayPalButtons() {
    window.paypal.Buttons({
      createOrder: async function() {
        const response = await fetch('/api/create-paypal-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            productId: productId
          })
        });
        const order = await response.json();
        return order.id;
      },
      onApprove: async function(data) {
        const response = await fetch('/api/capture-paypal-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            orderID: data.orderID, 
            formulaId: productId
          })
        });
        const captureData = await response.json();
        if (captureData.status === 'COMPLETED') {
          window.location.href = `/checkout/success?order_id=${captureData.orderId}&formula_id=${productId}`;
        } else {
          alert('Le paiement PayPal n\'a pas pu être capturé.');
        }
      },
      onError: function(err) {
        console.error('PayPal Error:', err);
        alert('Erreur PayPal. Veuillez réessayer.');
      }
    }).render('#paypal-button-container');
  }

  initPayPalSDK();

  // 3. Effet 3D Tilt interactif sur la carte principale et HUD Tooltips
  const tiltCard = document.getElementById('main-image-card');
  const tiltWrapper = document.getElementById('hud-3d-wrapper');

  if (tiltWrapper && tiltCard) {
    tiltWrapper.addEventListener('mousemove', (e) => {
      const rect = tiltWrapper.getBoundingClientRect();
      const x = e.clientX - rect.left; // x position inside element.
      const y = e.clientY - rect.top;  // y position inside element.
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      // Calculate rotation (-10deg to 10deg)
      const rotateX = ((centerY - y) / centerY) * 12;
      const rotateY = ((x - centerX) / centerX) * 12;
      
      tiltCard.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
    });

    tiltWrapper.addEventListener('mouseleave', () => {
      tiltCard.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)`;
    });
  }

  // Hotspots HUD tooltip logic
  const hotspots = document.querySelectorAll('.hud-hotspot');
  const tooltipCard = document.getElementById('hud-tooltip-card');
  const tooltipText = document.getElementById('hud-tooltip-text');

  hotspots.forEach(hotspot => {
    hotspot.addEventListener('mouseenter', () => {
      const tip = hotspot.getAttribute('data-tooltip');
      tooltipText.textContent = tip;
      tooltipCard.classList.add('active');
    });
  });

  // 4. Code du mini-simulateur de charge (Speedometer + SVG)
  const sliderQualif = document.getElementById('slider-qualif');
  const sliderRangeText = document.getElementById('slider-range-text');
  const sliderPercentageText = document.getElementById('slider-percentage-text');
  const timeStandardVal = document.getElementById('time-standard-val');
  const timeBorneVal = document.getElementById('time-borne-val');
  const batteryFill = document.getElementById('battery-fill');
  const gaugeProgress = document.getElementById('gauge-progress');
  const gaugePowerDisplay = document.getElementById('gauge-power-display');

  const maxPower = parseFloat(powerOutput);
  const maxCurrent = productId.includes('7') ? 32 : productId.includes('11') ? 16 : 32;

  function updateSimulation() {
    const value = parseInt(sliderQualif.value);
    sliderRangeText.textContent = `De 20% à ${20 + value}%`;
    sliderPercentageText.textContent = `+${value}%`;

    const batteryCapacity = 52;
    const energyNeeded = batteryCapacity * (value / 100);

    const hoursStandard = energyNeeded / 2.3;
    timeStandardVal.textContent = formatHours(hoursStandard);

    const hoursBorne = energyNeeded / maxPower;
    timeBorneVal.textContent = formatHours(hoursBorne);

    // Update battery SVG width (max width = 84px inside the rect)
    const fillWidth = (value / 100) * 84;
    batteryFill.setAttribute('width', fillWidth.toString());

    // Update Speedometer Gauge (max dashoffset = -31, min = -219)
    const currentAmp = Math.round((value / 100) * maxCurrent);
    gaugePowerDisplay.textContent = `${currentAmp}A`;

    // Map 0 -> maxCurrent to range 0 -> 188
    const progressOffset = -31 - ((currentAmp / maxCurrent) * 188);
    gaugeProgress.style.strokeDashoffset = progressOffset.toString();
  }

  function formatHours(decimalHours) {
    const hours = Math.floor(decimalHours);
    const minutes = Math.round((decimalHours - hours) * 60);
    if (hours === 0) return `${minutes}m`;
    return `${hours}h ${minutes.toString().padStart(2, '0')}m`;
  }

  sliderQualif.addEventListener('input', updateSimulation);
  updateSimulation();

  // 5. Scroll Reveal animations
  const revealElements = document.querySelectorAll('.scroll-reveal');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  revealElements.forEach(el => observer.observe(el));
</script>

