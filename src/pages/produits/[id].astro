---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;

// Catalogue de produits physique ultra-détaillé
const DEFAULT_PRODUCTS = [
  {
    id: 'wattcharge-home-7',
    name: 'Borne de Recharge Monophasée 7.4 kW | Connectée WiFi',
    subtitle: 'Modèle Intelligent - 7.4 kW / 32A monophasé',
    description: 'La borne de recharge connectée WattCharge Home 7.4 kW est conçue pour charger rapidement et sereinement votre véhicule électrique à domicile. Grâce à l\'application Tuya Smart Life intégrée, planifiez vos charges en heures creuses, suivez votre consommation en temps réel et réglez le courant de charge (de 8A à 32A) d\'un simple geste. Son boîtier IP66 robuste et son écran LCD couleur de 2,8" en font une borne premium, idéale pour l\'intérieur comme l\'extérieur.',
    price: 389.00,
    compare_at_price: 599.00,
    power_output: '7.4 kW',
    phase: 'Monophasé',
    current_rating: '32A',
    features: [
      'Puissance de charge réglable en direct (8A/10A/13A/16A/32A)',
      'WiFi & Bluetooth intégrés - Application Tuya Smart Life',
      'Écran LCD couleur 2,8" avec indicateur d\'état LED',
      'Lecteur de badge RFID (3 badges inclus) ou Plug & Charge',
      'Étanchéité IP66 maximale pour installation extérieure',
      'Protection différentielle intégrée RCD DC 6mA + AC 30mA (Évite un différentiel Type B onéreux)'
    ],
    specs_grid: {
      power: '7.4 kW',
      current: '32A',
      phase: 'Monophasé',
      cable: '5 mètres (Type 2 intégré)',
      ground_cable: '90 cm (Câble de terre)',
      wifi: 'Oui (Tuya WiFi / Bluetooth)',
      material: 'Polycarbonate haute résistance',
      rcd: 'DC 6mA + AC 30mA intégré'
    },
    protections: [
      { name: 'Protection contre les surcharges', desc: 'Désactivation automatique si le véhicule demande plus de courant que le calibre réglé.' },
      { name: 'Protection contre la sur-décharge', desc: 'Gestion de l\'équilibre et arrêt en cas d\'inversion ou baisse brutale de tension.' },
      { name: 'Protection contre les courts-circuits', desc: 'Coupure électronique instantanée en cas de court-circuit sur la prise.' },
      { name: 'Protection contre la surchauffe', desc: 'Arrêt automatique à 85°C avec reprise automatique sécurisée à 70°C.' },
      { name: 'Protection contre la surtension', desc: 'Dispositif de sécurité coupant l\'alimentation en cas de surtension réseau (>265V).' },
      { name: 'Protection contre la basse tension', desc: 'Alerte et mise en sécurité si la tension chute sous un seuil critique (<180V).' }
    ]
  },
  {
    id: 'wattcharge-home-11',
    name: 'Borne de Recharge Triphasée 11 kW | Connectée WiFi',
    subtitle: 'Modèle Intelligent - 11 kW / 16A triphasé',
    description: 'Bénéficiez d\'une recharge accélérée et sécurisée avec la borne triphasée WattCharge 11 kW. Spécifiquement calibrée pour les installations électriques triphasées de 400V, elle équilibre la puissance sur les 3 phases pour délivrer une charge stable et rapide à 16A. Équipée du WiFi Tuya pour un contrôle intelligent à distance, elle intègre toutes les sécurités indispensables à une charge de nuit sans surveillance.',
    price: 449.00,
    compare_at_price: 699.00,
    power_output: '11 kW',
    phase: 'Triphasé',
    current_rating: '16A',
    features: [
      'Puissance de charge triphasée réglable (8A/10A/13A/16A)',
      'WiFi & Bluetooth intégrés - Application Tuya Smart Life',
      'Écran LCD couleur 2,8" avec statut dynamique de charge',
      'Accès sécurisé par badges RFID (3 badges inclus) ou démarrage libre',
      'Châssis étanche IP66 résistant aux projections d\'eau et poussières',
      'Protection différentielle intégrée RCD DC 6mA + AC 30mA conforme aux normes'
    ],
    specs_grid: {
      power: '11 kW',
      current: '16A (par phase)',
      phase: 'Triphasé',
      cable: '5 mètres (Type 2 intégré)',
      ground_cable: '90 cm (Câble de terre)',
      wifi: 'Oui (Tuya WiFi / Bluetooth)',
      material: 'Polycarbonate haute résistance',
      rcd: 'DC 6mA + AC 30mA intégré'
    },
    protections: [
      { name: 'Protection contre les surcharges', desc: 'Surveillance des 3 phases pour couper le circuit en cas de surcharge d\'une phase.' },
      { name: 'Protection contre la sur-décharge', desc: 'Sécurité de phase inversée et coupure immédiate en cas de défaut d\'isolement.' },
      { name: 'Protection contre les courts-circuits', desc: 'Coupure triphasée ultra-rapide (<50ms) en cas de court-circuit franc.' },
      { name: 'Protection contre la surchauffe', desc: 'Capteur de température électronique avec arrêt à 85°C et redémarrage à 70°C.' },
      { name: 'Protection contre la surtension', desc: 'Arrêt de sécurité en cas de hausse anormale de tension sur l\'une des phases.' },
      { name: 'Protection contre la basse tension', desc: 'Mise en sécurité si la tension triphasée passe sous 320V entre phases.' }
    ]
  },
  {
    id: 'wattcharge-pro-22',
    name: 'Borne de Recharge Triphasée 22 kW | Performance Ultime',
    subtitle: 'Modèle Intelligent - 22 kW / 32A triphasé',
    description: 'La borne WattCharge Pro 22 kW est le choix sans compromis pour recharger votre voiture électrique à vitesse maximale. Délivrant jusqu\'à 22 kW en triphasé 32A, elle est capable de diviser par 8 le temps de recharge par rapport à une prise classique. Son écran LCD de 2,8" affiche tous les détails de charge (kW injectés, ampérage, temps) tandis que l\'application Tuya permet de gérer l\'accès ou de restreindre l\'usage de la borne.',
    price: 489.00,
    compare_at_price: 799.00,
    power_output: '22 kW',
    phase: 'Triphasé',
    current_rating: '32A',
    features: [
      'Puissance maximale de 22 kW en triphasé 32A (ajustable en continu)',
      'WiFi & Bluetooth intégrés - Application Tuya Smart Life',
      'Écran LCD couleur 2,8" complet (indicateur de puissance, tension, ampérage)',
      'Accès par badge RFID (3 inclus) pour éviter l\'utilisation non autorisée',
      'Boîtier renforcé IK10 et étanchéité IP66 extérieure',
      'Conforme NF C 15-100 avec détection intégrée DC 6mA'
    ],
    specs_grid: {
      power: '22 kW',
      current: '32A (par phase)',
      phase: 'Triphasé',
      cable: '5 mètres (Type 2 intégré)',
      ground_cable: '90 cm (Câble de terre)',
      wifi: 'Oui (Tuya WiFi / Bluetooth)',
      material: 'Polycarbonate haute résistance',
      rcd: 'DC 6mA + AC 30mA intégré'
    },
    protections: [
      { name: 'Protection contre les surcharges', desc: 'Coupure automatique pour éviter l\'échauffement de l\'installation triphasée 32A.' },
      { name: 'Protection contre la sur-décharge', desc: 'Système d\'équilibrage actif et arrêt de sécurité en cas de pic de puissance.' },
      { name: 'Protection contre les courts-circuits', desc: 'Coupure ultra-rapide préservant l\'électronique interne de la borne.' },
      { name: 'Protection contre la surchauffe', desc: 'Sonde de protection thermique limitant ou coupant le courant au-delà de 85°C.' },
      { name: 'Protection contre la surtension', desc: 'Coupe le raccordement en cas de surtension transitoire sur le réseau.' },
      { name: 'Protection contre la basse tension', desc: 'Mise en veille sécurisée de la borne si le réseau triphasé s\'affaisse.' }
    ]
  }
];

const product = DEFAULT_PRODUCTS.find(p => p.id === id);

if (!product) {
  return Astro.redirect('/');
}

const paypalClientId = import.meta.env.PAYPAL_CLIENT_ID || 'placeholder-client-id';
---

<Layout 
  title={`${product.name}`} 
  description={product.description.substring(0, 160)}
>
  <!-- Cyberpunk Background Grid Overlay -->
  <div class="cyber-grid-bg"></div>

  <section class="product-detail-section">
    <div class="product-glow"></div>
    <div class="container">
      
      <div class="product-detail-grid">
        
        <!-- Colonne Gauche : Galerie Image + HUD Interactif 3D -->
        <div class="product-gallery-column">
          <a href="/#catalog" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour au catalogue</a>
          
          <!-- Conteneur 3D Interactif avec Hotspots (Scanner HUD) -->
          <div class="hud-3d-wrapper" id="hud-3d-wrapper">
            <div class="main-image-card 3d-card" id="main-image-card">
              <img src="/images/charger.png" alt={product.name} class="detail-product-img" />
              <div class="power-overlay">{product.power_output}</div>
              
              <!-- HUD Scanner Grid Overlay -->
              <div class="hud-scanner-overlay"></div>

              <!-- Hotspot 1 : Écran LCD -->
              <div class="hud-hotspot" style="top: 25%; left: 50%;" data-tooltip="Écran couleur LCD 2.8 pouces indiquant en direct la puissance injectée (kW), la tension et l'ampérage.">
                <span class="hotspot-ping"></span>
                <span class="hotspot-dot"></span>
              </div>

              <!-- Hotspot 2 : RFID Reader -->
              <div class="hud-hotspot" style="top: 48%; left: 50%;" data-tooltip="Lecteur de cartes RFID intégré. Permet un accès sécurisé par badge pour empêcher tout vol d'électricité.">
                <span class="hotspot-ping"></span>
                <span class="hotspot-dot"></span>
              </div>

              <!-- Hotspot 3 : LED Circle Status -->
              <div class="hud-hotspot" style="top: 68%; left: 50%;" data-tooltip="Cercle lumineux dynamique à 3 états LED pour repérer le statut de charge en un coup d'œil.">
                <span class="hotspot-ping"></span>
                <span class="hotspot-dot"></span>
              </div>

              <!-- Floating Tooltip Card inside HUD -->
              <div class="hud-tooltip-card glass-panel" id="hud-tooltip-card">
                <h5 class="text-gradient-electric"><i class="fa-solid fa-microchip"></i> SPÉCIFICATION HUD</h5>
                <p id="hud-tooltip-text">Survolez un capteur lumineux sur la borne pour inspecter ses fonctionnalités avancées.</p>
              </div>
            </div>
          </div>
          
          <div class="product-guarantees-grid">
            <div class="guarantee-badge-item glass-panel">
              <i class="fa-solid fa-shield-check text-gradient-electric"></i>
              <div>
                <strong>Garantie 2 Ans</strong>
                <p>Échange standard rapide.</p>
              </div>
            </div>
            <div class="guarantee-badge-item glass-panel">
              <i class="fa-solid fa-truck-fast text-gradient-electric"></i>
              <div>
                <strong>Livraison Gratuite</strong>
                <p>Expédition sous 24/48h.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Colonne Droite : Configuration & Achat -->
        <div class="product-info-column">
          <div class="product-header">
            <span class="badge-certified"><i class="fa-solid fa-bolt-lightning text-gradient-electric"></i> Produit Certifié CE</span>
            <h1 class="product-title text-glow-teal">{product.name}</h1>
            <p class="product-subtitle">{product.subtitle}</p>
            
            <div class="product-rating">
              <div class="stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <span>(43 avis clients)</span>
              <span class="stock-indicator"><span class="pulse-indicator"></span> En Stock (3-5 jours)</span>
            </div>

            <div class="price-header-block">
              <span class="detail-price">{Number(product.price).toFixed(2).replace('.', ',')} €</span>
              {product.compare_at_price && (
                <span class="detail-compare-price">{Number(product.compare_at_price).toFixed(2).replace('.', ',')} €</span>
              )}
            </div>
          </div>

          <p class="detail-desc">{product.description}</p>

          <!-- Avantages Clés -->
          <div class="key-features-bullets glass-panel glow-panel">
            <h4><i class="fa-solid fa-microchip text-gradient-electric"></i> Points clés :</h4>
            <ul>
              {product.features.map(f => (
                <li><i class="fa-solid fa-check text-gradient-electric"></i> {f}</li>
              ))}
            </ul>
          </div>

          <!-- Module d'Achat direct -->
          <div class="checkout-actions-block">
            <button id="stripe-buy-btn" class="btn-primary select-formula-btn cyber-btn">
              Payer par Carte Bancaire / Apple Pay (Stripe) <i class="fa-solid fa-credit-card"></i>
            </button>
            <div class="checkout-divider">
              <span>OU</span>
            </div>
            <!-- PayPal Button Container -->
            <div id="paypal-button-container"></div>
          </div>

          <div class="secure-badge-row">
            <span><i class="fa-solid fa-lock text-gradient-electric"></i> Transaction Sécurisée SSL</span>
            <span><i class="fa-solid fa-rotate-left text-gradient-electric"></i> Satisfait ou Remboursé 14j</span>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1 : CARACTÉRISTIQUES TECHNIQUES DE LA BORNE DE RECHARGE (Design BornePlus + Neon Glowing Grid) -->
  <section class="section-tech-specs">
    <div class="specs-neon-glow"></div>
    <div class="container">
      <h2 class="section-title-specs text-glow-teal">CARACTÉRISTIQUES TECHNIQUES DE LA BORNE</h2>
      
      <div class="specs-icons-grid">
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-bolt"></i></div>
          <h4>Max puissance de charge : <strong class="text-gradient-electric">{product.specs_grid.power}</strong></h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-tv"></i></div>
          <h4>Écran LED Couleur 2.8"</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-circle-nodes"></i></div>
          <h4>Courant de sortie : {product.specs_grid.current}</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-arrows-left-right"></i></div>
          <h4>Longueur de terre : {product.specs_grid.ground_cable}</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-plug"></i></div>
          <h4>Prise : Type 2 Standard</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-circle-notch"></i></div>
          <h4>Grand cercle LED coloré statut</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-lock"></i></div>
          <h4>Antivol électronique véhicule</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-power-off"></i></div>
          <h4>Bouton d'arrêt d'urgence rouge</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-wifi"></i></div>
          <h4>Connexion WIFI / Bluetooth</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-toolbox"></i></div>
          <h4>Support mural acier inclus</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-box"></i></div>
          <h4>Matériau : Polycarbonate</h4>
        </div>
        <div class="spec-icon-card glass-panel scroll-reveal">
          <div class="spec-icon-circle"><i class="fa-solid fa-shield-halved"></i></div>
          <h4>{product.specs_grid.rcd}</h4>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2 : FONCTIONNALITÉS (Design BornePlus + Left Side Glow Mockup) -->
  <section class="section-features">
    <div class="container features-flex">
      <div class="features-visual scroll-reveal">
        <div class="visual-box-mockup glass-panel glow-panel-teal tilt-image">
          <div class="pulse-glow-circle"></div>
          <img src="/images/charger.png" alt="WattCharge Smart Wallbox" />
        </div>
      </div>
      <div class="features-content scroll-reveal">
        <h2>FONCTIONNALITÉS DE POINTE</h2>
        <ul class="features-checked-list">
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Démarrage de la recharge par carte de recharge IC</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Démarrage à distance par application mobile</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Contrôle de charge à distance</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Arrêt de la recharge à distance ou par bouton</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Vérification à distance de la charge de réserve</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Notifications push d'état de charge</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Contrôle de température intelligent</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Contrôle de tension de haute précision</li>
          <li><i class="fa-solid fa-circle-check text-gradient-electric"></i> Historique complet des kilowattheures</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SECTION 3 : SÉCURITÉ (Design BornePlus + Electrician Asset) -->
  <section class="section-security">
    <div class="container security-grid">
      <div class="security-left scroll-reveal">
        <h2>SÉCURITÉ MAXIMUM</h2>
        <p class="security-subtitle-text text-gradient-electric">Protection garantie contre tous les risques électriques</p>
        
        <div class="security-cards-box">
          {product.protections.map(p => (
            <div class="security-detail-card glass-panel hover-scale">
              <i class="fa-solid fa-shield-halved text-gradient-electric"></i>
              <div>
                <h4>{p.name}</h4>
                <p>{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="security-right scroll-reveal">
        <div class="security-visual-image-wrapper glow-panel">
          <img src="/images/electrician_installation.png" alt="Professionnel de la sécurité électrique" />
          <div class="image-hud-line"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4 : VOTRE INDÉPENDANCE, À PORTÉE DE MAIN (Design BornePlus) -->
  <section class="section-independence">
    <div class="container">
      <div class="independence-header">
        <h2 class="text-glow-teal">VOTRE INDÉPENDANCE, À PORTÉE DE MAIN</h2>
        <p class="text-gradient-electric">La solution qui vous rend 100% autonome</p>
      </div>
      
      <div class="independence-cards">
        <div class="independence-card glass-panel hover-scale">
          <h3>Ne dépendez plus des bornes publiques</h3>
          <p>
            Malgré le programme de déploiement de 100 000 bornes sur le territoire français, le droit à la prise est loin d'être effectif, sachant que les structures de recharge publiques sont rarement libres en journée. Les conducteurs et propriétaires de voiture électrique doivent faire la queue ou partir à la recherche d'une autre borne en poursuivant leur chargemap, ce qui est très coûteux en temps et en argent.
          </p>
          <a href="/#catalog" class="btn-learn-more"><i class="fa-solid fa-plus"></i> EN SAVOIR PLUS</a>
        </div>
        <div class="independence-card glass-panel hover-scale">
          <h3>Une borne de recharge rapide, qui attend dans votre garage</h3>
          <p>
            La station de recharge WattCharge a été pensée pour tous les profils d'utilisateurs de véhicule électrique. Composée d'un boîtier de recharge robuste, étanche et léger, elle se fixe simplement au mur d'un garage ou dans un endroit couvert de votre cour extérieure pour être toujours prête.
          </p>
          <a href="/#catalog" class="btn-learn-more"><i class="fa-solid fa-plus"></i> EN SAVOIR PLUS</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5 : INTERACTIVE HUD CHARGING SIMULATOR (Défouloir Visuel et Speedomètre Interactif SVG) -->
  <section class="section-simulator">
    <div class="container">
      <div class="product-simulator-wrapper glass-panel glow-panel-teal">
        <div class="simulator-header">
          <h3><i class="fa-solid fa-gauge text-gradient-electric"></i> Simulateur Interactif HUD de Vitesse de Charge</h3>
          <p>Ajustez le niveau cible pour simuler la charge en direct et observer l'aiguille du tachymètre de la borne.</p>
        </div>
        
        <div class="simulator-inner-grid">
          
          <div class="simulator-fields">
            <div class="control-group">
              <label for="slider-qualif">Niveau de recharge requis :</label>
              <div class="slider-display">
                <span id="slider-range-text">De 20% à 80%</span>
                <strong id="slider-percentage-text" class="text-gradient-electric">+60%</strong>
              </div>
              <input type="range" id="slider-qualif" min="10" max="100" value="60" class="range-slider" />
            </div>

            <!-- Animated SVG Battery -->
            <div class="battery-svg-wrapper">
              <svg viewBox="0 0 100 40" class="battery-svg">
                <rect x="2" y="2" width="90" height="36" rx="4" fill="none" stroke="var(--border-color)" stroke-width="2" />
                <rect x="94" y="12" width="4" height="16" rx="2" fill="var(--border-color)" />
                <!-- Glowing inner progress -->
                <rect id="battery-fill" x="5" y="5" width="54" height="30" rx="2" fill="url(#battery-glow)" />
                <defs>
                  <linearGradient id="battery-glow" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#53B7A8" />
                    <stop offset="100%" stop-color="#6F94A6" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
            
            <div class="simulator-vehicle-specs">
              <span>Puissance nominale délivrée : <strong>{product.power_output}</strong></span>
              <span>Alimentation requise : <strong>{product.phase} ({product.current_rating})</strong></span>
            </div>
          </div>

          <div class="simulator-visual-results">
            <!-- Tachometer Gauges HUD -->
            <div class="tachometers-wrapper">
              <div class="gauge-item">
                <div class="gauge-dial">
                  <svg viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#e2e8f0" stroke-width="8" stroke-dasharray="188 250" stroke-dashoffset="-31" />
                    <circle id="gauge-progress" cx="50" cy="50" r="40" fill="none" stroke="var(--accent-teal)" stroke-width="8" stroke-dasharray="188 250" stroke-dashoffset="-31" />
                  </svg>
                  <div class="gauge-value" id="gauge-power-display">--</div>
                </div>
                <span>Ampérage Actuel</span>
              </div>
            </div>

            <div class="vis-result-item">
              <span>Temps Prise Classique (2.3 kW)</span>
              <strong id="time-standard-val">--</strong>
            </div>
            <div class="vis-result-item highlight-item">
              <span class="text-gradient-electric"><i class="fa-solid fa-bolt"></i> Temps Borne WattCharge</span>
              <strong id="time-borne-val" class="text-gradient-electric">--</strong>
            </div>
